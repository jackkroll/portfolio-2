---
import { appStoreCount, projectCount } from "../data/projects";
import { featuredProjects } from "../data/projects";
import pfp from '../assets/pfp.webp'
---

<section class="hero min-h-[calc(100svh-4rem)] overflow-visible bg-base-100 md:h-[calc(100svh-4rem)] md:overflow-hidden">
    <div class="hero-content mx-auto grid min-h-0 w-full max-w-6xl grid-rows-[auto_auto] place-items-start gap-6 p-4 md:h-full md:grid-cols-[1.05fr_0.95fr] md:grid-rows-1 md:gap-10 md:px-8">
        <main>
        <div class="max-w-2xl items-center">
            <figure class="">
                <img
                    class="mask mask-squircle aspect-square w-48 md:w-64 lg:w-72"
                    src={pfp.src}
                    width={pfp.width}
                    height={pfp.height}
                    alt="A black and white picture of Jack"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                />
            </figure>
            <h1 class="mt-3 text-4xl font-bold leading-tight text-base-content md:mt-0 md:text-7xl">Hey! I'm Jack Kroll</h1>
            <p class="mt-4 max-w-xl text-base leading-7 text-base-content/75 md:mt-6 md:text-lg md:leading-8">
                I'm a Software Engineering student who likes to make stuff easier with software, and hopefully make it less ugly in the process
            </p>
            <div class="mt-5 flex flex-wrap gap-3 md:mt-8">
                <a class="btn btn-primary" href="/projects">All Projects</a>
                <a class="btn btn-outline btn-disabled" href="/photography">Photography (coming soon)</a>
            </div>
        </div>
        </main>

        <aside class="grid w-full gap-5 md:min-h-0 md:self-stretch">
            <section id="featured" class="flex flex-col md:min-h-0">
                <div class="flex flex-col p-0 md:min-h-0 md:px-8">
                    <div class="mb-4 flex flex-row items-end justify-between gap-3 md:mb-8">
                        <div>
                            <p class="text-sm font-semibold uppercase tracking-wide text-secondary">My Recent Work</p>
                        </div>
                        <a class="btn btn-soft btn-sm" href="/projects/">Browse all</a>
                    </div>

                    <div class="grid gap-5 overflow-visible pr-1 md:min-h-0 md:grid-cols-1 md:overflow-y-auto">
                        {featuredProjects.sort((a,b) => b.relevancyDate.getTime() - a.relevancyDate.getTime()).map((project) => (
                                <article class="card bg-base-200 shadow-lg">
                                    <div class="card-body">
                                        <p class="card-title mt-3 text-2xl">{project.title}</p>
                                        <p class="text-lg text-accent">{project.kicker}</p>
                                        <p class="leading-7 text-base-content/75">{project.summary}</p>
                                        <div class="card-actions mt-3">
                                            <a class="btn btn-primary btn-sm" href={`/projects/${project.slug}/`}>Details</a>
                                            {project.links.slice(0, 1).map((link) => (
                                                    <a
                                                            class="btn btn-outline btn-sm"
                                                            href={link.href}
                                                            target={link.href.startsWith("http") ? "_blank" : undefined}
                                                            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                                                    >
                                                        {link.label}
                                                    </a>
                                            ))}
                                        </div>
                                    </div>
                                </article>
                        ))}
                    </div>
                </div>
            </section>

        </aside>
    </div>
</section>
