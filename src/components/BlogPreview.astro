---
import { getCollection } from "astro:content";

const formatPostDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});

const posts = (await getCollection("blogPosts"))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<section id="blog">
	<div class="mx-auto max-w-6xl py-4">
		<div class="mb-4 flex flex-row items-end justify-between gap-3 md:mb-8">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-secondary">Blog</p>
			</div>
			<a class="btn btn-soft btn-sm" href="/blog/">Browse all</a>
		</div>

		{posts.length > 0 ? (
			<div class="grid gap-5 flex flex-col">
				{posts.map((post) => (
					<article class="card bg-base-200 shadow-lg w-full">
						<div class="card-body">
							<p class="text-sm font-semibold text-primary">{formatPostDate(post.data.date)}</p>
							<h3 class="card-title mt-2 text-2xl">{post.data.title}</h3>
							<p class="leading-7 text-base-content/75">{post.data.description}</p>
							<div class="card-actions mt-3">
								<a class="btn btn-primary btn-sm" href={`/blog/${post.id}/`}>Read post</a>
							</div>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="rounded-box border border-base-300 bg-base-100 p-6 text-base-content/75">
				<p>No posts yet.</p>
			</div>
		)}
	</div>
</section>
