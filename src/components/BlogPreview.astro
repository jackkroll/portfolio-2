---
import { getCollection } from "astro:content";

const formatPostDate = (date: Date) =>
	date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});

const posts = (await getCollection("blogPosts"))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<section id="blog" class="bg-base-200">
	<div class="mx-auto max-w-6xl px-4 py-16 md:px-8">
		<div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="text-sm font-semibold uppercase tracking-wide text-secondary">Blog</p>
				<h2 class="mt-2 text-3xl font-bold md:text-4xl">Latest writing</h2>
			</div>
			<a class="btn btn-outline btn-sm" href="/blog/">View all</a>
		</div>

		{posts.length > 0 ? (
			<div class="grid gap-5 md:grid-cols-3">
				{posts.map((post) => (
					<article class="card bg-base-100 shadow-lg">
						<div class="card-body">
							<p class="text-sm font-semibold text-primary">{formatPostDate(post.data.date)}</p>
							<h3 class="card-title mt-2 text-2xl">{post.data.title}</h3>
							<p class="leading-7 text-base-content/75">{post.data.description}</p>
							<div class="card-actions mt-3">
								<a class="btn btn-primary btn-sm" href={`/blog/${post.id}/`}>Read post</a>
							</div>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="rounded-box border border-base-300 bg-base-100 p-6 text-base-content/75">
				<p>No posts yet.</p>
			</div>
		)}
	</div>
</section>
