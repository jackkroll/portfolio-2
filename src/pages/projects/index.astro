---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";
---

<Layout title="Projects | Jack Kroll" description="All projects migrated from Jack Kroll's original portfolio.">
	<main class="bg-base-100 h-full">
		<section class="mx-auto max-w-6xl px-4 py-16 md:px-8">
			<div class="max-w-3xl">
				<p class="text-sm font-semibold uppercase tracking-wide text-primary">Projects</p>
				<h1 class="mt-2 text-4xl font-bold md:text-6xl">My Projects</h1>
				<p class="mt-5 text-lg leading-8 text-base-content/70">
					A collection of my various side projects :)
				</p>
			</div>

			<div class="mt-10 grid gap-5 h-full md:grid-cols-2 lg:grid-cols-3 ">
				{projects.map((project) => (
					<article class="card bg-base-200 shadow-lg">
						<div class="card-body">
							<h2 class="card-title mt-2">{project.title}</h2>
							<h4 class="text-primary font-semibold">{project.kicker}</h4>
							<p class="leading-7 text-base-content/70">{project.summary}</p>
							<div class="mt-3 flex flex-wrap gap-2">
								{project.tech.slice(0, 3).map((item) => <span class="badge badge-outline">{item}</span>)}
							</div>
							<div class="card-actions mt-4">
								<a class="btn btn-primary btn-sm w-full" href={`/projects/${project.slug}/`}>View project</a>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>
