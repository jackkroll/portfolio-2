---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const projectAssets = (project.assets ?? []).map((asset) => (/\.[a-z0-9]+$/i.test(asset) ? asset : `${asset}.png`));
const projectPreviewSlides = projectAssets.map((asset, index) => ({
	asset,
	id: `${project.slug}-preview-${index + 1}`,
	previousIndex: index === 0 ? projectAssets.length - 1 : index - 1,
	nextIndex: index === projectAssets.length - 1 ? 0 : index + 1,
	label: `${project.title} preview ${index + 1}`,
}));
---

<Layout title={`${project.title} | Jack Kroll`} description={project.summary}>
	<main class="bg-base-100">
		<section class="mx-auto max-w-6xl px-4 py-12 md:px-8">
			<div class="breadcrumbs text-sm">
				<ul>
					<li><a href="/">Home</a></li>
					<li><a href="/projects">Projects</a></li>
					<li>{project.title}</li>
				</ul>
			</div>
			<div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
				<article>

					<h1 class="mt-5 text-4xl font-bold leading-tight md:text-6xl">{project.title}</h1>
					<div class="flex flex-wrap gap-2 my-4">{project.tech.map((item) => <span class="badge badge-outline badge-lg">{item}</span>)}
					</div>
					<p class="mt-5 max-w-3xl text-xl leading-9 text-base-content/75">{project.summary}</p>

					{projectPreviewSlides.length > 0 && (
						<div class="mt-5 max-w-xs">
							<div class="carousel w-fit rounded-box bg-base-200" data-project-preview-carousel>
								{projectPreviewSlides.map((slide, index) => (
									<div id={slide.id} class="carousel-item w-fit shrink-0 px-5 py-8" data-project-preview-slide>
										<div class="flex w-full flex-col items-center">
											<div class="mockup-phone border-primary mx-auto w-fit">
												<div class="mockup-phone-camera"></div>
												<div class="mockup-phone-display bg-base-100">
													<img
														src={slide.asset}
														alt={slide.label}
														loading={index === 0 ? "eager" : "lazy"}
													/>
												</div>
											</div>
											<div class="mt-5 flex justify-center gap-3">
												<button class="btn btn-circle btn-sm" type="button" aria-label="Previous preview" data-project-preview-target={slide.previousIndex}>❮</button>
												<button class="btn btn-circle btn-sm" type="button" aria-label="Next preview" data-project-preview-target={slide.nextIndex}>❯</button>
											</div>
										</div>
									</div>
								))}
							</div>
						</div>
					)}

					<div class="prose prose-invert mt-8 max-w-none">
						{project.description.map((paragraph) => <p class="my-4">{paragraph}</p>)}
					</div>
				</article>

				<aside class="grid content-start gap-5">
					<div class="card bg-base-200 shadow-lg">
						<div class="card-body">
							<h2 class="card-title">Highlights</h2>
							<ul class="mt-2 space-y-3">
								{project.highlights.map((highlight) => (
									<li class="rounded-box border border-base-300 bg-base-100 p-3 text-sm leading-6 text-base-content/75">{highlight}</li>
								))}
							</ul>
						</div>
					</div>

					<div class="card bg-base-200 shadow-lg">
						<div class="card-body">
							<h2 class="card-title">Links</h2>
							<div class="flex flex-wrap gap-2">
								{project.links.map((link) => (
									<a
										class:list={["btn btn-sm", link.kind === "primary" ? "btn-primary" : "btn-outline"]}
										href={link.href}
										target={link.href.startsWith("http") ? "_blank" : undefined}
										rel={link.href.startsWith("http") ? "noreferrer" : undefined}
									>
										{link.label}
									</a>
								))}
							</div>
							{project.related && (
								<div class="mt-4 border-t border-base-300 pt-4">
									<p class="mb-2 text-sm font-semibold text-base-content/70">Related from the original sitemap</p>
									<div class="flex flex-wrap gap-2">
										{project.related.map((link) => (
											<a class="badge badge-outline p-3" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
										))}
									</div>
								</div>
							)}
						</div>
					</div>
				</aside>
			</div>
		</section>
	</main>

	<script>
		const carousel = document.querySelector("[data-project-preview-carousel]");

		if (carousel instanceof HTMLElement) {
			const slides = Array.from(carousel.querySelectorAll("[data-project-preview-slide]"));
			const buttons = carousel.querySelectorAll("[data-project-preview-target]");

			buttons.forEach((button) => {
				button.addEventListener("click", () => {
					if (!(button instanceof HTMLElement)) return;

					const targetIndex = Number(button.dataset.projectPreviewTarget);
					const targetSlide = slides[targetIndex];

					if (!(targetSlide instanceof HTMLElement)) return;

					carousel.scrollTo({
						left: targetSlide.offsetLeft - carousel.offsetLeft,
						behavior: "smooth",
					});
				});
			});
		}
	</script>
</Layout>
