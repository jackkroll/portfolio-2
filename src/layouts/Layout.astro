---
import "../assets/app.css";

interface Props {
	title?: string;
	description?: string;
	hideFooter?: boolean;
	bodyClass?: string;
}

const {
	title = "Jack's Portfolio",
	description = "Jack Kroll's portfolio of iOS apps, tools, and technical projects.",
	hideFooter = false,
	bodyClass = "",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="sunset">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class:list={["flex min-h-screen flex-col bg-base-100 text-base-content", bodyClass]}>
		<div class="navbar sticky top-0 z-30 border-b border-base-300/70 bg-base-100/90 px-4 backdrop-blur md:px-8">
			<div class="navbar-start">
				<a class="btn btn-ghost px-2 text-lg font-semibold" href="/">Jack Kroll</a>
			</div>
			<nav class="navbar-end gap-1">
				<a class="btn btn-ghost btn-sm" href="/projects/">Projects</a>
				<a class="btn btn-ghost btn-sm" href="mailto:me@jackk.dev">Contact</a>
				<a class="btn btn-primary btn-sm" href="https://github.com/jackkroll" target="_blank" rel="noreferrer">GitHub</a>
			</nav>
		</div>
		<div class="flex-1">
			<slot />
		</div>
		{!hideFooter && (
			<footer class="border-t border-base-300 bg-base-200">
				<div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-base-content/70 md:flex-row md:items-center md:justify-between md:px-8">
					<p>Made by Jack. Migrated from the original jackk.dev Hugo portfolio to Astro and DaisyUI.</p>
					<div class="flex gap-4">
						<a class="link-hover link" href="/projects/">Projects</a>
						<a class="link-hover link" href="mailto:me@jackk.dev">me@jackk.dev</a>
					</div>
				</div>
			</footer>
		)}
	</body>
</html>
